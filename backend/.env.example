# ---------------------------------------------------------
# Server
# ---------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------
# MySQL Database
# ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mediso_db
DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------
# Auth
# ---------------------------------------------------------
# Use a long random string in production, e.g. `openssl rand -hex 64`
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------
# AI Integration (Gemini)
# Get a key at https://console.gemini.com/
# If left empty, the AI features automatically fall back to safe
# rule-based responses so the app still runs end-to-end.
# ---------------------------------------------------------
GEMINI_API_KEY= "api-key-here"
GEMINI_MODEL="model here"
GEMINI_API_VERSION=2023-06-01
